# Optional bootstrap input. An empty password means generate it on first start.
# The initializer and Compose services will be implemented in plan step 4.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Pinned images for the future Compose setup.
GOLANG_IMAGE=golang:1.26.8-alpine3.24
ALPINE_IMAGE=alpine:3.24.3
PROMETHEUS_IMAGE=prom/prometheus:v3.15.1
GRAFANA_IMAGE=grafana/grafana:13.3.0
# Do not upgrade without checking externally-controlled duration: "0s" support.
K6_IMAGE=grafana/k6:1.6.0
